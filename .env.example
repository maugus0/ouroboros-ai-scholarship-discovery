# ======================================
# SCHOLARSHIP DISCOVERY AGENT - CONFIGURATION
# ======================================

# -------- Database (MySQL) --------
DB_HOST=localhost
DB_NAME=ouroboros_scholarship_db
DB_USERNAME=root
DB_PASSWORD=your_password_here
DB_PORT=3306

DB_POOL_SIZE=10
DB_POOL_NAME=scholarship_discovery_pool
DB_CONNECTION_TIMEOUT=20

# Docker MySQL port (host-side, avoids collision with other agents)
DOCKER_MYSQL_PORT=3310

# -------- Inter-Service Authentication --------
X_SERVICE_TOKEN=your-super-secret-service-token-here-change-this

# -------- LLM Configuration --------
# Primary: OpenAI
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=2000
OPENAI_TEMPERATURE=0.1

# Fallback: Anthropic
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_MAX_TOKENS=2000

# Retry
LLM_MAX_RETRIES=3
LLM_RETRY_DELAY=2

# -------- Crawling Configuration --------
SCRAPY_CONCURRENT_REQUESTS=8
SCRAPY_DOWNLOAD_DELAY=2.0
SCRAPY_USER_AGENT_ROTATION=true
MIN_CRAWL_DELAY_SECONDS=2
MAX_CRAWL_DELAY_SECONDS=5
RESPECT_ROBOTS_TXT=true

# Staleness: re-crawl scholarships older than N days
SCHOLARSHIP_STALENESS_DAYS=30

# Batch crawl schedule (cron: Sunday 3 AM UTC — 1 hour after Program Discovery)
BATCH_CRAWL_CRON=0 3 * * 0

# -------- 4-Dimension Linking Weights (must sum to 100) --------
LINKING_WEIGHT_UNIVERSITY=50
LINKING_WEIGHT_FIELD=30
LINKING_WEIGHT_DEGREE=15
LINKING_WEIGHT_GEOGRAPHIC=5

# -------- Confidence Score Thresholds --------
MIN_LINK_CONFIDENCE_SCORE=0.40

# -------- Application --------
LOG_LEVEL=INFO
USE_MOCK_DATA=false
ALLOW_DB_FAILURE=false
