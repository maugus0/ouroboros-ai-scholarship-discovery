# Pylint configuration aligned with Program Discovery Agent (shared backend standards).

[MAIN]
py-version = 3.11

[BASIC]
good-names=_pool,_client,_scheduler,i,j,k,_,exc,fd,Run,id

[FORMAT]
max-line-length = 120

[DESIGN]
max-args = 8
max-positional-arguments = 8

[SIMILARITIES]
min-similarity-lines = 20
ignore-imports = yes

[MESSAGES CONTROL]
disable =
    C0111,
    C0301,
    C0327,
    E0401,
    R0902,
    R0903,
    R0911,
    R0912,
    R0913,
    R0914,
    R0915,
    W0212,
    W0613,
    W0621,
    W0718
